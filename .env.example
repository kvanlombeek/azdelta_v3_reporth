# Kopieer naar .env en vul aan. .env staat in .gitignore: nooit committen.
ENTRA_CLIENT_ID=d9a501a1-7c73-4c19-98dc-2a9b6d35f3c3
ENTRA_CLIENT_SECRET=                 # lokaal: waarde uit Entra; in Cloud Run via Secret Manager
ENTRA_AUTHORITY=organizations
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
ENTRA_POST_LOGOUT_URI=http://localhost:8000/auth/logged-out
ENTRA_ALLOWED_TENANTS=de5dcc4b-b4d4-4eca-8851-2cb8bdd62c7b,0d2411fc-02b6-455e-86db-122a475d9273
ENTRA_ALLOWED_EMAILS=                # optioneel, komma-gescheiden
SESSION_SECRET=                      # python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_HTTPS_ONLY=false             # lokaal false, in productie true
# PostgreSQL (Cloud SQL). Lokaal via de Cloud SQL Auth Proxy op 127.0.0.1:5432.
# Speciale tekens in het wachtwoord URL-encoden (bv. @ -> %40). Op Cloud Run via Secret Manager.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ortho_db_omop
